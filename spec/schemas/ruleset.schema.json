{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchloop.dev/schemas/ruleset/v1",
  "title": "PatchLoop rule set, version 1",
  "description": "Structure only. Cross-field rules (parent chains, binding targets, defaults) are in rule-semantics.md section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "resources", "tools"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "principal": {"const": true},
          "owner_field": {"type": "string", "minLength": 1},
          "tenant_field": {"type": "string", "minLength": 1},
          "parent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource", "field"],
            "properties": {
              "resource": {"type": "string", "minLength": 1},
              "field": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["access", "effect"],
        "properties": {
          "access": {"enum": ["public", "authenticated", "scoped"]},
          "effect": {"enum": ["none", "state_write", "external"]},
          "consent": {"type": "boolean"},
          "description": {"type": "string"},
          "limits": {
            "type": "array",
            "minItems": 1,
            "description": "Version 2 only. Each limited argument must be a decimal no greater than max.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["argument", "max"],
              "properties": {
                "argument": {"type": "string", "minLength": 1},
                "max": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}
              }
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["argument", "resource"],
              "properties": {
                "argument": {"type": "string", "minLength": 1, "description": "Top-level argument name, or a JSON Pointer (RFC 6901) when it starts with /"},
                "resource": {"type": "string", "minLength": 1},
                "cardinality": {"enum": ["one", "many"]}
              }
            }
          }
        }
      }
    }
  }
}
