# Copy to .env.local. All values are optional and are read at build time.

# Public address of this site. Used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=

# Address of the docs site. Until it is set, docs links point at the matching
# file in the GitHub repository.
NEXT_PUBLIC_DOCS_URL=

# Contact address shown in the footer and used by "Talk to us" as a mailto link.
# Until it is set, both point at GitHub issues.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional endpoint that receives "Talk to us" submissions as a JSON POST
# ({ name, email, agent, stack, source }). Takes precedence over the mailto link.
NEXT_PUBLIC_LEAD_ENDPOINT=
